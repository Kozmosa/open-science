[Unit]
Description=OpenScience durable domain worker
Documentation=https://github.com/open-science/open-science
Wants=network-online.target
After=network-online.target ainrf.service
ConditionPathExists=/opt/ainrf/state/runtime/agentic_researcher.sqlite3

[Service]
Type=simple
User=ainrf
Group=ainrf
SupplementaryGroups=ainrf_tenants
# The operator-managed environment file must contain the exact immutable
# AINRF_DOMAIN_ARTIFACT_SHA. The CLI rejects an absent/mismatched SHA
# and refuses to run without a current release binding.
EnvironmentFile=-/etc/ainrf/domain-worker.env
# The CLI verifies the immutable artifact SHA before the worker claims work.
ExecStart=/usr/local/bin/openscience domain-worker --state-root /opt/ainrf/state
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target
